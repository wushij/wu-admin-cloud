# ==========================================
# 🛑 用户指定忽略的目录
# ==========================================
/docs/
/wu-admin-copy/

# 说明：.vscode 目录已按要求保留提交，不加入忽略名单

# ==========================================
# ☕ Java & Maven 编译/构建产物
# ==========================================
target/
*.class
*.jar
*.war
*.ear
*.nar
*.hprof
hs_err_pid*
replay_pid*

# Maven Wrapper 如需入库，取消下一行注释
# !.mvn/wrapper/maven-wrapper.jar

# ==========================================
# 💻 IDE & 编辑器（保留 .vscode）
# ==========================================
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.factorypath
*.swp
*~
*.bak
*.orig

# Cursor 本地态（规则/技能若要共享可改成白名单）
.cursor/
!.vscode/

# ==========================================
# 🌐 前端 Node.js 依赖与打包产物
# ==========================================
node_modules/
dist/
dist-ssr/
.vite/
.turbo/
.pnpm-store/
wu-admin-uniapp/unpackage/
wu-admin-uniapp/dist/

# 前端本地环境变量（示例 .env.example 仍可提交）
.env.local
.env.*.local
.env.development.local
.env.production.local
.eslintcache
.stylelintcache
coverage/
*.lcov

# ==========================================
# 📂 运行时日志、临时文件与上传数据
# ==========================================
*.log
logs/
**/data/file-upload/*
!**/data/file-upload/.gitkeep
**/data/uploads/*
!**/data/uploads/.gitkeep
tmp/
temp/
*.tmp

# Sentinel / Nacos 本地落盘（若写到工程目录）
**/csp/
**/nacos/

# ==========================================
# 🖥️ 操作系统生成的临时文件
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
