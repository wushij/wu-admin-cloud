package com.wu.cloud.api.${moduleName}.feign;

import com.wu.cloud.api.${moduleName}.dto.${className}DTO;
import com.wu.cloud.common.core.domain.R;
import org.springframework.cloud.openfeign.FeignClient;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestParam;

import java.util.List;

/**
 * 远程${functionName}服务 OpenFeign 契约
 *
 * @author ${author}
 * @since ${date}
 */
@FeignClient(contextId = "remote${className}Service", value = "wu-service-${moduleName}",
        path = "/inner/${moduleName}/${businessName}")
public interface Remote${className}Service {

    /**
     * 按主键查询${functionName}
     */
    @GetMapping("/get")
    R<${className}DTO> get${className}(@RequestParam("id") Long id);

    /**
     * 按主键集合批量查询${functionName}
     */
    @PostMapping("/list-by-ids")
    R<List<${className}DTO>> listByIds(@RequestBody List<Long> ids);
}
