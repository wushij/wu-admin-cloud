<template>
  <div class="app-container">
    <!-- 查询表单 -->
    <el-form :model="queryParams" :inline="true" class="search-form">
#foreach($column in $columns)
#if($column.query && !$column.baseField && !$column.pk)
      <el-form-item label="$!{column.columnComment}">
        <el-input
          v-model="queryParams.${column.javaField}"
          placeholder="请输入$!{column.columnComment}"
          clearable
          @keyup.enter="handleQuery"
        />
      </el-form-item>
#end
#end
      <el-form-item>
        <el-button type="primary" @click="handleQuery">查询</el-button>
        <el-button @click="resetQuery">重置</el-button>
      </el-form-item>
    </el-form>

    <!-- 操作栏 -->
    <el-row :gutter="10" class="mb-2">
      <el-col :span="1.5">
        <el-button v-hasPermi="['${permissionPrefix}:add']" type="primary" @click="handleAdd">
          新增
        </el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button
          v-hasPermi="['${permissionPrefix}:remove']"
          type="danger"
          :disabled="selectedIds.length === 0"
          @click="handleBatchDelete"
        >
          删除
        </el-button>
      </el-col>
    </el-row>

    <!-- 数据表格 -->
    <el-table v-loading="loading" :data="list" @selection-change="handleSelectionChange">
      <el-table-column type="selection" width="55" align="center" />
#foreach($column in $columns)
#if($column.list && !$column.baseField && !$column.pk)
      <el-table-column label="$!{column.columnComment}" prop="${column.javaField}" show-overflow-tooltip />
#end
#end
      <el-table-column label="创建时间" prop="createTime" width="180" />
      <el-table-column label="操作" width="160" fixed="right">
        <template #default="scope">
          <el-button v-hasPermi="['${permissionPrefix}:edit']" link type="primary" @click="handleUpdate(scope.row)">
            修改
          </el-button>
          <el-button v-hasPermi="['${permissionPrefix}:remove']" link type="danger" @click="handleDelete(scope.row)">
            删除
          </el-button>
        </template>
      </el-table-column>
    </el-table>

    <!-- 分页 -->
    <el-pagination
      v-model:current-page="queryParams.pageNo"
      v-model:page-size="queryParams.pageSize"
      :total="total"
      :page-sizes="[10, 20, 50, 100]"
      layout="total, sizes, prev, pager, next, jumper"
      @size-change="getList"
      @current-change="getList"
    />

    <!-- 新增/修改弹窗 -->
    <el-dialog v-model="dialogVisible" :title="dialogTitle" width="600px" append-to-body>
      <el-form ref="formRef" :model="form" :rules="rules" label-width="100px">
#foreach($column in $columns)
#if($column.form && !$column.baseField && !$column.pk)
        <el-form-item label="$!{column.columnComment}" prop="${column.javaField}">
          <el-input v-model="form.${column.javaField}" placeholder="请输入$!{column.columnComment}" />
        </el-form-item>
#end
#end
      </el-form>
      <template #footer>
        <el-button @click="dialogVisible = false">取 消</el-button>
        <el-button type="primary" :loading="submitting" @click="submitForm">确 定</el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import type { FormInstance } from 'element-plus'
import {
  get${className}Page,
  create${className},
  update${className},
  delete${className},
  type ${className},
  type ${className}PageQuery
} from '@/api/${moduleName}/${businessName}'

defineOptions({ name: '${className}' })

const loading = ref(false)
const submitting = ref(false)
const dialogVisible = ref(false)
const dialogTitle = ref('')
const list = ref<${className}[]>([])
const total = ref(0)
const selectedIds = ref<number[]>([])
const formRef = ref<FormInstance>()

const queryParams = reactive<${className}PageQuery>({
  pageNo: 1,
  pageSize: 10
})

const form = reactive<${className}>({})

const rules = {
#foreach($column in $columns)
#if($column.form && $column.required && !$column.baseField && !$column.pk)
  ${column.javaField}: [{ required: true, message: '$!{column.columnComment}不能为空', trigger: 'blur' }],
#end
#end
}

/** 查询列表 */
async function getList() {
  loading.value = true
  try {
    const data = await get${className}Page(queryParams)
    list.value = data.list
    total.value = data.total
  } finally {
    loading.value = false
  }
}

function handleQuery() {
  queryParams.pageNo = 1
  getList()
}

function resetQuery() {
  Object.keys(queryParams).forEach((key) => {
    if (key !== 'pageNo' && key !== 'pageSize') {
      // @ts-expect-error 动态重置查询条件
      queryParams[key] = undefined
    }
  })
  handleQuery()
}

function handleSelectionChange(rows: ${className}[]) {
  selectedIds.value = rows.map((row) => row.id!).filter(Boolean)
}

function resetForm() {
  Object.keys(form).forEach((key) => {
    // @ts-expect-error 动态重置表单
    form[key] = undefined
  })
  formRef.value?.clearValidate()
}

function handleAdd() {
  resetForm()
  dialogTitle.value = '新增${functionName}'
  dialogVisible.value = true
}

function handleUpdate(row: ${className}) {
  resetForm()
  Object.assign(form, row)
  dialogTitle.value = '修改${functionName}'
  dialogVisible.value = true
}

async function submitForm() {
  if (!formRef.value) return
  await formRef.value.validate()
  submitting.value = true
  try {
    if (form.id) {
      await update${className}(form)
      ElMessage.success('修改成功')
    } else {
      await create${className}(form)
      ElMessage.success('新增成功')
    }
    dialogVisible.value = false
    getList()
  } finally {
    submitting.value = false
  }
}

async function handleDelete(row: ${className}) {
  await ElMessageBox.confirm('确认删除该条${functionName}吗？', '提示', { type: 'warning' })
  await delete${className}([row.id!])
  ElMessage.success('删除成功')
  getList()
}

async function handleBatchDelete() {
  await ElMessageBox.confirm('确认删除选中的 ' + selectedIds.value.length + ' 条数据吗？', '提示', {
    type: 'warning'
  })
  await delete${className}(selectedIds.value)
  ElMessage.success('删除成功')
  getList()
}

onMounted(getList)
</script>
